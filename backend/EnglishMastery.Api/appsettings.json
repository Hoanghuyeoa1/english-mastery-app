{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EnglishMasteryDev;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "EnglishMasteryDevJwtSecretKeyMustBeAtLeast32BytesLongForHmacSha256Security!",
    "Issuer": "EnglishMastery.Api",
    "Audience": "EnglishMastery.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "Finalization": {
    "ApiKey": "dev-finalization-secret-key",
    "AutoScheduleEnabled": false
  },
  "Google": {
    "ClientId": "development-google-client-id.apps.googleusercontent.com",
    "ClientSecret": "development-google-client-secret-placeholder",
    "RedirectUri": "http://localhost:5000/api/auth/google/callback",
    "AllowedReturnUrls": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  }
}

